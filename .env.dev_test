VITE_ENV_TARGET=dev_test
VITE_APP_TITLE=南京市第十三中学 · 成长愿景

# ===== auth-layout-zw 鉴权初始化参数（dev_test 环境）=====
# 以下均为占位值，接入真实环境前请逐项替换

# 应用前缀，区分不同应用（可按实际约定调整）
VITE_APP_PREFIX=thDevelopment
# 应用来源标识 TODO 替换为真实值
VITE_APP_ORIGIN=thDevelopment
# 应用编码 TODO 必填真实值
VITE_APP_CODE=C1137
# 应用等级：0=市级 1=区级 2=校级（演示主体为“南京市第十三中学”，默认校级 2，可调整）
VITE_APP_LEVEL=2
# 基础 API 地址 TODO 替换为真实接口地址
VITE_BASE_API_URL=https://oatest.jsnje.cn/console
# 环境标识：dev / joint / prod（dev_test 对应 dev）
VITE_ENV_CONFIG=dev
# 环境调用标识：用于标识请求的来源，防止接口调用混淆
VITE_ENV_CONFIG_X_CALLER=zw-edu-test
